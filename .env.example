# --- Neon Postgres --------------------------------------------------------
# From https://console.neon.tech → your project → Connection Details.
# Use the "Pooled connection" URL.
DATABASE_URL="postgres://<user>:<password>@<host>/<db>?sslmode=require"

# --- Admin ---------------------------------------------------------------
# Password for /admin sign-in. Minimum 8 characters. Also used as the HMAC
# secret for the admin session cookie — change it and every admin session is
# invalidated.
ADMIN_PASSWORD="change-me-to-something-long"
